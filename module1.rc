#include <windows.h>
#define IDD_DIALOG1 101
#define IDC_SCROLLBAR1 1001
#define IDC_STATIC_NUM 1002

IDD_DIALOG1 DIALOGEX 0, 0, 210, 80
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Step 1: Select number"
FONT 8, "MS Shell Dlg"
BEGIN
    SCROLLBAR       IDC_SCROLLBAR1, 20, 20, 170, 12, SBS_HORZ | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 35, 45, 60, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 115, 45, 60, 14
END