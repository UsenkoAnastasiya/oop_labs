#include <windows.h>
#define IDD_DIALOG2A 102
#define IDC_BTN_NEXT 1002

IDD_DIALOG2A DIALOGEX 0, 0, 210, 80
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Step 1 of 2"
FONT 8, "MS Shell Dlg"
BEGIN
    PUSHBUTTON      "Next >", IDC_BTN_NEXT, 30, 40, 70, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 110, 40, 70, 14
END
