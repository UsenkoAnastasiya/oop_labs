#include <windows.h>
#define IDD_DIALOG2B 103
#define IDC_BTN_BACK 1003

IDD_DIALOG2B DIALOGEX 0, 0, 210, 80
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Step 2 of 2"
FONT 8, "MS Shell Dlg"
BEGIN
    PUSHBUTTON      "< Back", IDC_BTN_BACK, 15, 40, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 80, 40, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 145, 40, 50, 14
END