#include "Resource.h"
#include "winres.h"

#pragma code_page(65001)

IDC_LAB2 MENU
BEGIN
    POPUP "Об’єкти"
    BEGIN
        MENUITEM "Крапка",         IDM_POINT
        MENUITEM "Лінія",          IDM_LINE
        MENUITEM "Прямокутник",    IDM_RECTANGLE
        MENUITEM "Еліпс",          IDM_ELLIPSE
    END
    POPUP "Довідка"
    BEGIN
        MENUITEM "Про програму...", IDM_ABOUT
        MENUITEM "Вихід",           IDM_EXIT
    END
END

IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Про програму"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Графічний редактор. Лабораторна №2",IDC_STATIC,14,14,140,8,SS_NOPREFIX
    LTEXT           "Варіант 25",IDC_STATIC,14,25,114,8
    DEFPUSHBUTTON   "OK",IDOK,113,41,50,14,WS_GROUP
END